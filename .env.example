# Environment Mode
ENVIRONMENT=development
PROJECT_NAME="CodeTarget"

# Backend Core Configuration
HOST=0.0.0.0
PORT=8000
SECRET_KEY=dev_secret_key_change_in_production_32bytes_minimum_length_required
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=codetarget_user
POSTGRES_PASSWORD=codetarget_password
POSTGRES_DB=codetarget_db
DATABASE_URL=postgresql+asyncpg://codetarget_user:codetarget_password@localhost:5432/codetarget_db

# Cache & Task Broker (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Code Execution Service (Judge0 Integration Abstraction)
JUDGE0_URL=http://localhost:2358
JUDGE0_API_KEY=your_judge0_api_key_if_cloud

# AI Integration (Google Gemini 2.5 Flash)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
